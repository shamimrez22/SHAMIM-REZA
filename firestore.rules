rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Portfolio master configuration, photo slots, and file metadata
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isValidId(portfolioId);
    }

    // Universal Cloud Synchronized Files (CV, Job Description, Custom Uploads)
    match /cloud_files/{fileId} {
      allow read: if true;
      allow write: if isValidId(fileId)
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 256;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isValidId(chunkId)
          && request.resource.data.data is string;
      }
    }

    // Data Vault Documents (IE Spreadsheets, DPR Reports, SOPs)
    match /vault_documents/{docId} {
      allow read: if true;
      allow write: if isValidId(docId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 256;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isValidId(chunkId)
          && request.resource.data.data is string;
      }
    }
  }
}

